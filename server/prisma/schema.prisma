// Production (Railway) runs Postgres -- this must stay "postgresql" here
// since this schema file is what the deployed backend uses. For local dev
// on the SQLite file, run `npm run db:local` instead of editing this: it
// writes a gitignored SQLite copy and syncs dev.db against it. Schema is
// written to be portable (no native enums/arrays -- enum-like fields are
// plain strings validated in application code).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id               String         @id @default(cuid())
  slug             String         @unique
  sku              String?        @unique
  name             String
  category         String
  subcategory      String
  description      String
  shortDescription String
  price            Float
  priceUnit        String
  material         String
  color            String
  pattern          String
  occasion         String
  availability     String         @default("Available") // Available | Made to Order | Sold Out
  featured         Boolean        @default(false)
  seoTitle         String         @default("")
  seoDescription   String         @default("")
  images           ProductImage[]
  orderItems       OrderItem[]
  wishlistedBy     WishlistItem[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model ProductImage {
  id        String  @id @default(cuid())
  src       String
  alt       String
  // What the shot shows, rendered as a badge on the product page:
  // "Catalogue" | "Blouse" | "Pallu" | "Detail" | "" (unlabelled)
  label     String  @default("")
  position  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
}

// Uploaded/AI-generated image bytes, served from GET /api/images/:id so
// product JSON carries a short URL instead of a multi-MB base64 string.
model ImageAsset {
  id        String   @id @default(cuid())
  mime      String
  data      Bytes
  createdAt DateTime @default(now())
}

model Category {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String
  image       String
  position    Int    @default(0)
}

model Occasion {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String
  image       String
  position    Int    @default(0)
}

model FabricType {
  id       String @id @default(cuid())
  slug     String @unique
  name     String
  position Int    @default(0)
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  location  String
  message   String
  rating    Int      @default(5)
  avatar    String?
  source    String   @default("Google") // e.g. Google, Direct
  featured  Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now())
}

model Banner {
  id        String   @id @default(cuid())
  image     String
  link      String?
  alt       String   @default("")
  position  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Order {
  id                String      @id @default(cuid())
  orderNumber       String      @unique
  customer          Customer?   @relation(fields: [customerId], references: [id])
  customerId        String?
  customerName      String
  email             String
  phone             String
  addressLine1      String
  addressLine2      String?
  city              String
  state             String
  pincode           String
  country           String      @default("India")
  subtotal          Float
  shippingFee       Float       @default(0)
  total             Float
  status            String      @default("pending") // pending | paid | shipped | delivered | cancelled
  razorpayOrderId   String?
  razorpayPaymentId String?
  shiprocketOrderId String?
  items             OrderItem[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model Customer {
  id           String         @id @default(cuid())
  name         String
  email        String         @unique
  phone        String         @default("")
  passwordHash String
  wishlist     WishlistItem[]
  orders       Order[]
  createdAt    DateTime       @default(now())
}

model WishlistItem {
  id         String   @id @default(cuid())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
}

model OrderItem {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  product   Product? @relation(fields: [productId], references: [id])
  productId String?
  name      String
  price     Float
  quantity  Int
  image     String?
}

model CareGuide {
  id        String   @id @default(cuid())
  title     String   // e.g. "Silk Care", "Cotton Care", "Wool Care"
  matchTerm String   // matched case-insensitively against a product's material/subcategory, e.g. "silk"
  content   String   // one instruction per line
  position  Int      @default(0)
  createdAt DateTime @default(now())
}

model Policy {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  image        String   @default("")
  // Array of { heading: string; body: string }, stored as JSON text for
  // sqlite/postgres portability -- parsed in application code.
  sectionsJson String   @default("[]")
  position     Int      @default(0)
  updatedAt    DateTime @updatedAt
}

model Settings {
  id                String @id @default("singleton")
  businessName      String @default("Krishna Gari Battala Kottu")
  phone             String @default("")
  whatsapp          String @default("")
  addressLine       String @default("")
  mapsUrl           String @default("")
  instagram         String @default("")
  facebook          String @default("")
  // Set these to your ACTUAL Google Business Profile numbers once you have
  // reviews -- leave googleReviewCount at 0 to hide the review badge rather
  // than show a fabricated rating.
  googleRating      Float  @default(0)
  googleReviewCount Int    @default(0)
  googleReviewUrl   String @default("")
}

model ScheduleCallRequest {
  id            String   @id @default(cuid())
  name          String
  phone         String
  preferredTime String
  notes         String?
  createdAt     DateTime @default(now())
}

model AdminUser {
  id           String @id @default(cuid())
  username     String @unique
  passwordHash String
}
