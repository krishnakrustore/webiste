// Production (Railway) runs Postgres -- this must stay "postgresql" here
// since this schema file is what the deployed backend uses. For local dev
// on the SQLite file, run `npm run db:local` instead of editing this: it
// writes a gitignored SQLite copy and syncs dev.db against it. Schema is
// written to be portable (no native enums/arrays -- enum-like fields are
// plain strings validated in application code).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id               String         @id @default(cuid())
  slug             String         @unique
  sku              String?        @unique
  name             String
  category         String
  subcategory      String
  description      String
  shortDescription String
  // Not shown on the website (enquiries go through WhatsApp); kept so existing rows stay valid.
  price            Float          @default(0)
  priceUnit        String         @default("")
  material         String
  color            String
  pattern          String
  occasion         String
  availability     String         @default("Available") // Available | Made to Order | Sold Out
  featured         Boolean        @default(false)
  // "draft" products (e.g. from bulk AI import) are hidden from the website until published.
  status           String         @default("published")
  seoTitle         String         @default("")
  seoDescription   String         @default("")
  images           ProductImage[]
  wishlistedBy     WishlistItem[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model ProductImage {
  id        String  @id @default(cuid())
  src       String
  alt       String
  // What the shot shows, rendered as a badge on the product page:
  // "Catalogue" | "Blouse" | "Pallu" | "Detail" | "" (unlabelled)
  label     String  @default("")
  position  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
}

// Uploaded/AI-generated image bytes, served from GET /api/images/:id so
// product JSON carries a short URL instead of a multi-MB base64 string.
model ImageAsset {
  id        String   @id @default(cuid())
  mime      String
  data      Bytes
  createdAt DateTime @default(now())
}

model Category {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String
  image       String
  position    Int    @default(0)
}

model Occasion {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String
  image       String
  position    Int    @default(0)
}

model FabricType {
  id       String @id @default(cuid())
  slug     String @unique
  name     String
  position Int    @default(0)
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  location  String
  message   String
  rating    Int      @default(5)
  avatar    String?
  source    String   @default("Google") // e.g. Google, Direct
  featured  Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now())
}

model Banner {
  id        String   @id @default(cuid())
  image     String
  link      String?
  alt       String   @default("")
  position  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Customer {
  id           String         @id @default(cuid())
  name         String
  email        String         @unique
  phone        String         @default("")
  passwordHash String
  wishlist     WishlistItem[]
  createdAt    DateTime       @default(now())
}

model WishlistItem {
  id         String   @id @default(cuid())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
}

model CareGuide {
  id        String   @id @default(cuid())
  title     String   // e.g. "Silk Care", "Cotton Care", "Wool Care"
  matchTerm String   // matched case-insensitively against a product's material/subcategory, e.g. "silk"
  content   String   // one instruction per line
  position  Int      @default(0)
  createdAt DateTime @default(now())
}

model Policy {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  image        String   @default("")
  // Array of { heading: string; body: string }, stored as JSON text for
  // sqlite/postgres portability -- parsed in application code.
  sectionsJson String   @default("[]")
  position     Int      @default(0)
  updatedAt    DateTime @updatedAt
}

model Settings {
  id                String @id @default("singleton")
  businessName      String @default("Krishna Gari Battala Kottu")
  phone             String @default("")
  whatsapp          String @default("")
  addressLine       String @default("")
  mapsUrl           String @default("")
  instagram         String @default("")
  facebook          String @default("")
  // Set these to your ACTUAL Google Business Profile numbers once you have
  // reviews -- leave googleReviewCount at 0 to hide the review badge rather
  // than show a fabricated rating.
  googleRating      Float  @default(0)
  googleReviewCount Int    @default(0)
  googleReviewUrl   String @default("")
}

model ScheduleCallRequest {
  id            String   @id @default(cuid())
  name          String
  phone         String
  preferredTime String
  notes         String?
  createdAt     DateTime @default(now())
}

model AdminUser {
  id           String @id @default(cuid())
  username     String @unique
  passwordHash String
}

// ---- Bulk AI import -------------------------------------------------------
// A batch is one upload session (e.g. the 1,500 photos from a pendrive).
// Photos are grouped into one ImportGroup per saree; each group becomes one
// draft Product with 3 AI-generated images once generation runs.
model ImportBatch {
  id        String        @id @default(cuid())
  name      String
  // uploading | grouping | review | running | paused | done
  status    String        @default("uploading")
  // "folders": one saree per folder. "ai": photos in shooting order, AI finds where each saree starts.
  mode      String        @default("ai")
  notes     String        @default("")
  error     String        @default("")
  createdAt DateTime      @default(now())
  photos    ImportPhoto[]
  groups    ImportGroup[]
}

model ImportGroup {
  id        String        @id @default(cuid())
  batch     ImportBatch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  batchId   String
  position  Int
  // pending | queued | processing | done | failed | skipped
  status    String        @default("pending")
  error     String        @default("")
  productId String?
  photos    ImportPhoto[]

  @@index([batchId, position])
  @@index([status])
}

model ImportPhoto {
  id       String       @id @default(cuid())
  batch    ImportBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  batchId  String
  group    ImportGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  groupId  String?
  // Shooting order within the batch, set when photos are grouped.
  position Int
  name     String
  folder   String       @default("")
  // Camera capture time from the photo's EXIF ("YYYY-MM-DDTHH:MM:SS"), "" if unknown.
  // This is what keeps an unorganised pendrive in shooting order.
  takenAt  String       @default("")
  src      String
  thumb    String

  @@unique([batchId, folder, name])
  @@index([batchId, position])
}
