# Local dev default (SQLite file). For Railway Postgres, set to the
# provided connection string and switch schema.prisma's provider to
# "postgresql".
DATABASE_URL="file:./dev.db"

PORT=4000

# Long random string used to sign admin JWTs. Generate your own for production.
JWT_SECRET="change-this-to-a-long-random-string"

# Origin(s) allowed to call this API from the browser.
CLIENT_ORIGIN="http://localhost:5173"

# Admin bootstrap -- used once by `npm run seed` to create the first admin
# user if none exists yet. Change the password after first login.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"

# Google Sign-In -- create an OAuth Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials, add your site's origin
# under "Authorized JavaScript origins". Same value goes in
# kgbk-website/.env as VITE_GOOGLE_CLIENT_ID. Without this, the "Continue
# with Google" button is hidden.
GOOGLE_CLIENT_ID=""

# AI Catalogue Assistant (Admin > Products > Add Product). Needs an OpenAI
# *API* key from https://platform.openai.com/api-keys with API billing set up
# -- a ChatGPT Plus/Pro subscription does NOT include API access. Without a
# key the assistant falls back to copy-paste prompts for ChatGPT.
OPENAI_API_KEY=""
# Optional overrides (defaults shown).
# OPENAI_IMAGE_MODEL="gpt-image-2.5-sunburst"
# OPENAI_TEXT_MODEL="gpt-5.4-mini"

# Cloudinary (optional): product and banner images are stored on Cloudinary's CDN instead of the database.
# Copy the three values from cloudinary.com > Settings > API Keys. Leave empty to keep images in the database.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Only for `npm run push-to-production` (copies your local published products to the live site).
# PROD_API_URL="https://<your-railway-domain>/api"
# PROD_ADMIN_USERNAME=""
# PROD_ADMIN_PASSWORD=""

# Public site URL, used in the sitemap.
SITE_URL="https://krishnagaribattalakottu.com"
# Optional: base URL for image links if the API moves to its own domain,
# e.g. "https://api.krishnagaribattalakottu.com". Defaults to the request host.
# PUBLIC_API_ORIGIN=""
