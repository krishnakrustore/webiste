# Local dev default (SQLite file). For Railway Postgres, set to the
# provided connection string and switch schema.prisma's provider to
# "postgresql".
DATABASE_URL="file:./dev.db"

PORT=4000

# Long random string used to sign admin JWTs. Generate your own for production.
JWT_SECRET="change-this-to-a-long-random-string"

# Origin(s) allowed to call this API from the browser.
CLIENT_ORIGIN="http://localhost:5173"

# Razorpay -- sign up free at https://dashboard.razorpay.com/ to get test
# keys (Settings > API Keys > Generate Test Key). Required for /api/payments
# routes to actually create orders -- without real keys, checkout will fail
# at the "create order" step.
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxx"

# Shiprocket -- sign up at https://www.shiprocket.in/, then use your
# account email/password here (Shiprocket's API exchanges these for a
# short-lived bearer token itself, there's no separate API key).
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""

# Admin bootstrap -- used once by `npm run seed` to create the first admin
# user if none exists yet. Change the password after first login.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"

# Google Sign-In -- create an OAuth Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials, add your site's origin
# under "Authorized JavaScript origins". Same value goes in
# kgbk-website/.env as VITE_GOOGLE_CLIENT_ID. Without this, the "Continue
# with Google" button is hidden.
GOOGLE_CLIENT_ID=""
